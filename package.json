{
  "name": "nscf",
  "version": "0.1.0",
  "private": true,
  "description": "NSCF — an independent, unofficial Nightscout downstream prototype for Cloudflare Workers",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "upstream:install": "npm --prefix vendor/nightscout ci --ignore-scripts",
    "upstream:bundle": "npm --prefix vendor/nightscout run bundle",
    "build:ui": "node scripts/build-upstream-ui.mjs",
    "build": "npm run upstream:bundle && npm run build:ui",
    "cf-typegen": "wrangler types",
    "check": "npm run cf-typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev --local",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "@cloudflare/workers-types": "latest",
    "@types/node": "^24.0.0",
    "ejs": "^3.1.10",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "latest"
  }
}
