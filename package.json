{
  "name": "nscf",
  "version": "0.1.0",
  "private": true,
  "description": "NSCF — an independent, unofficial Nightscout downstream prototype for Cloudflare Workers",
  "license": "AGPL-3.0-only",
  "type": "module",
  "cloudflare": {
    "bindings": {
      "API_SECRET": {
        "description": "家庭访问密码（至少 12 个字符）。部署完成后，在手机 Nightscout 数据源中填写同一个密码；不需要处理哈希。"
      }
    }
  },
  "scripts": {
    "upstream:audit": "node scripts/audit-upstream-contracts.mjs",
    "upstream:audit:check": "node scripts/audit-upstream-contracts.mjs --check",
    "test:upstream-audit": "node --test scripts/audit-upstream-contracts.test.mjs",
    "test:auth-audit": "node --test scripts/audit-auth-contracts.test.mjs",
    "upstream:install": "npm --prefix vendor/nightscout ci --ignore-scripts",
    "upstream:bundle": "npm --prefix vendor/nightscout run bundle",
    "build:ui": "node scripts/build-upstream-ui.mjs",
    "build": "npm run upstream:bundle && npm run build:ui",
    "cf-typegen": "wrangler types",
    "check": "npm run cf-typegen && tsc --noEmit",
    "test": "npm run upstream:audit:check && npm run test:upstream-audit && npm run test:auth-audit && vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev --local",
    "deploy:dry": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "latest",
    "@cloudflare/workers-types": "latest",
    "@types/node": "^24.0.0",
    "ejs": "^3.1.10",
    "typescript": "~5.9.3",
    "vitest": "^4.1.0",
    "wrangler": "latest"
  },
  "dependencies": {
    "accepts": "1.3.8",
    "csv-stringify": "5.6.5",
    "easyxml": "2.0.1",
    "mime": "2.6.0",
    "shiro-trie": "0.4.10"
  }
}
